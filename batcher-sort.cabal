cabal-version: 3.0
name: batcher-sort
version: 0.1.0.0
build-type: Simple

executable batcher-sort
    main-is: Main.hs
    build-depends:
        base >=4.19 && <5,
        parallel >=3.3,
        deepseq
    default-language: Haskell2010
    ghc-options:
        -Wall
        -O2
        -threaded
        -rtsopts